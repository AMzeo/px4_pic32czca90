CONFIG_BOARD_TOOLCHAIN="arm-none-eabi"
CONFIG_BOARD_ARCHITECTURE="cortex-m7"
# CONFIG_BOARD_CONSTRAINED_FLASH is not set
# CONFIG_BOARD_EXTERNAL_METADATA is not set
CONFIG_BOARD_SERIAL_GPS1="/dev/ttyS1"
CONFIG_BOARD_SERIAL_RC="/dev/ttyS2"
CONFIG_BOARD_PARAM_FILE="/fs/mtd_params"

# USB CDC/ACM
CONFIG_DRIVERS_CDCACM_AUTOSTART=y

# HITL Simulation Support
CONFIG_MODULES_SIMULATION_PWM_OUT_SIM=y

# Core Modules
CONFIG_MODULES_BATTERY_STATUS=y
CONFIG_MODULES_COMMANDER=y
CONFIG_MODULES_EVENTS=y
CONFIG_MODULES_CONTROL_ALLOCATOR=y
CONFIG_MODULES_DATAMAN=y
CONFIG_MODULES_EKF2=y
CONFIG_EKF2_AUX_GLOBAL_POSITION=y
CONFIG_EKF2_AUXVEL=y
CONFIG_EKF2_DRAG_FUSION=y
CONFIG_EKF2_EXTERNAL_VISION=y
CONFIG_EKF2_GNSS_YAW=y
CONFIG_EKF2_RANGE_FINDER=y
CONFIG_MODULES_FLIGHT_MODE_MANAGER=y
CONFIG_MODULES_LAND_DETECTOR=y
CONFIG_MODULES_LOGGER=y
CONFIG_LOGGER_STACK_SIZE=4500
CONFIG_MODULES_MANUAL_CONTROL=y
CONFIG_MODULES_MAVLINK=y
CONFIG_DRIVERS_GPS=y
CONFIG_DRIVERS_RC_INPUT=y

# Multicopter Control
CONFIG_MODULES_MC_ATT_CONTROL=y
CONFIG_MODULES_MC_POS_CONTROL=y
CONFIG_MODULES_MC_RATE_CONTROL=y
CONFIG_MODULES_MC_HOVER_THRUST_ESTIMATOR=y

# Calibration & Estimation
CONFIG_MODULES_GYRO_CALIBRATION=y
CONFIG_MODULES_MAG_BIAS_ESTIMATOR=y

# System Monitoring
CONFIG_MODULES_LOAD_MON=y

# Navigation
CONFIG_MODULES_NAVIGATOR=y
CONFIG_MODULES_RC_UPDATE=y

# Sensors
CONFIG_MODULES_SENSORS=y

# SPI IMU — 6DOF IMU 27 Click (ICM-45686 on SERCOM8, MIKROE-6514)
CONFIG_DRIVERS_IMU_INVENSENSE_ICM45686=y
# Fallback: 6DOF IMU 6 Click (ICM-20689, MIKROE-4044)
CONFIG_DRIVERS_IMU_INVENSENSE_ICM20689=y

# I2C IMU (compiled but not started — needed for linker I2C bus symbol resolution)
CONFIG_DRIVERS_IMU_BOSCH_BMI088_I2C=y

# I2C Barometer — Pressure 5 Click (BMP388 on SERCOM5/I2C5, MIKROE-3566, addr 0x76/0x77)
CONFIG_DRIVERS_BAROMETER_BMP388=y

# I2C Magnetometer — Geomagnetic Click (BMM150 on SERCOM5/I2C5, MIKROE-2935, addr 0x10)
CONFIG_DRIVERS_MAGNETOMETER_BOSCH_BMM150=y

# PWM motor output
CONFIG_DRIVERS_PWM_OUT=y

# Work queue tuning (match SAMV71 — pwm_out init chain is deep)
CONFIG_WQ_HP_DEFAULT_STACKSIZE=4096

# System Commands (matching SAMV71 production)
# dmesg requires BOARD_ENABLE_CONSOLE_BUFFER, disabled in board_config.h
# (broken C++ static-init semaphore on this port family — see comment there)
CONFIG_SYSTEMCMDS_BSONDUMP=y
CONFIG_SYSTEMCMDS_I2CDETECT=y
CONFIG_SYSTEMCMDS_LED_CONTROL=y
CONFIG_SYSTEMCMDS_MFT=y
CONFIG_SYSTEMCMDS_MTD=y
CONFIG_SYSTEMCMDS_NSHTERM=y
CONFIG_SYSTEMCMDS_PARAM=y
CONFIG_SYSTEMCMDS_PERF=y
CONFIG_SYSTEMCMDS_REBOOT=y
CONFIG_SYSTEMCMDS_SYSTEM_TIME=y
CONFIG_SYSTEMCMDS_TOP=y
CONFIG_SYSTEMCMDS_TOPIC_LISTENER=y
CONFIG_SYSTEMCMDS_UORB=y
CONFIG_SYSTEMCMDS_VER=y
CONFIG_SYSTEMCMDS_WORK_QUEUE=y
CONFIG_SYSTEMCMDS_ACTUATOR_TEST=y
