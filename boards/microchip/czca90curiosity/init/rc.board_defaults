#!/bin/sh
# PIC32CZ CA90 Curiosity Ultra board defaults

# Parameter storage: SD card (/fs/microsd/params) while testing SDMMC in isolation.
# SQI flash (MTD) disabled temporarily - will re-enable with re-init dance for coexistence.
# rc.filepaths already sets PARAM_FILE=/fs/microsd/params via CONFIG_BOARD_PARAM_FILE.

if [ -d "/fs/microsd" ]
then
	echo "INFO [init] SD card mounted at /fs/microsd"
else
	echo "WARN [init] SD card NOT mounted - /fs/microsd missing"
fi

# USB CDC/ACM driver not yet implemented - disable cdcacm_autostart.
# NOTE: param set-default does NOT override the active in-memory value when
# param import fails (no storage). param set forces the value for this session.
param set-default SYS_AUTOSTART 0
param set-default SYS_USB_AUTO -1
param set-default USB_MAV_MODE 0
param set-default MAV_0_CONFIG 101
param set-default MAV_0_RATE 57600
param set-default MAV_0_FORWARD 0
param set-default SDLOG_MODE -1

# No sensors connected during initial bringup - disable checks that require them.
# Change to 1 when physical hardware is installed.
param set-default SYS_HAS_MAG 0
param set-default SYS_HAS_BARO 0
param set-default COM_ARM_SDCARD 0

# Circuit breakers to allow arming without full sensor suite
param set-default CBRK_SUPPLY_CHK 894281
param set-default COM_ARM_WO_GPS 1

# Circuit breaker for flight termination (required for HITL)
param set-default CBRK_FLIGHTTERM 121212

# HITL actuator output configuration (quadcopter)
param set-default HIL_ACT_FUNC1 101
param set-default HIL_ACT_FUNC2 102
param set-default HIL_ACT_FUNC3 103
param set-default HIL_ACT_FUNC4 104
