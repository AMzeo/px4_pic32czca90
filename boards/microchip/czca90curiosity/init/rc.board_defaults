#!/bin/sh
# PIC32CZ CA90 Curiosity Ultra board defaults

echo "RAWTEST rc.board_defaults entered"

# Storage: SQI1 flash = params/caldata/dataman (/fs/mtd_params)
#          SDMMC0 = flight logs (/fs/microsd)

if [ -d "/fs/microsd" ]
then
	echo "INFO [init] SD card mounted at /fs/microsd"
else
	echo "WARN [init] SD card NOT mounted - /fs/microsd missing"
fi

# USB CDC/ACM driver not yet implemented - disable cdcacm_autostart.
# NOTE: param set-default does NOT override the active in-memory value when
# param import fails (no storage). param set forces the value for this session.
param set SYS_AUTOSTART 4001
param set-default SYS_USB_AUTO 2
param set-default USB_MAV_MODE 0
param set-default SDLOG_MODE 0

# Disable GPS and RC input — no devices connected on fresh board.
# These default to valid serial ports which block boot waiting for data.
param set GPS_1_CONFIG 0
param set GPS_2_CONFIG 0
param set RC_PORT_CONFIG 0


# No sensors connected during initial bringup - disable checks that require them.
param set SYS_HAS_MAG 0
param set SYS_HAS_BARO 0
param set COM_ARM_SDCARD 0

# Circuit breakers to allow arming without full sensor suite
param set CBRK_SUPPLY_CHK 894281
param set COM_ARM_WO_GPS 1

# Circuit breaker for flight termination (required for HITL)
param set CBRK_FLIGHTTERM 121212

# HITL actuator output configuration (quadcopter)
param set-default HIL_ACT_FUNC1 101
param set-default HIL_ACT_FUNC2 102
param set-default HIL_ACT_FUNC3 103
param set-default HIL_ACT_FUNC4 104

# PWM motor output — TCC1 (ch 1-2) + TCC7 (ch 3-4), 400 Hz
param set-default PWM_MAIN_TIM0 400
param set-default PWM_MAIN_TIM1 400
param set-default PWM_MAIN_FUNC1 101
param set-default PWM_MAIN_FUNC2 102
param set-default PWM_MAIN_FUNC3 103
param set-default PWM_MAIN_FUNC4 104
