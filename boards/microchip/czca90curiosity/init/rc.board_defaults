#!/bin/sh
# PIC32CZ CA90 Curiosity Ultra board defaults

# MAVLink enabled on USB CDC/ACM (ttyACM0)
# Default airframe: Generic Quad (4001)
param set-default SYS_AUTOSTART 4001
param set-default SYS_USB_AUTO -1
param set-default USB_MAV_MODE 0
param set-default MAV_0_CONFIG 101
param set-default MAV_0_RATE 57600
param set-default MAV_0_FORWARD 0
param set-default SDLOG_MODE -1

# Enable sensor processing pipelines
param set-default SYS_HAS_MAG 1
param set-default SYS_HAS_BARO 1

# Circuit breakers to allow arming without full sensor suite
param set-default CBRK_SUPPLY_CHK 894281
param set-default COM_ARM_WO_GPS 1

# Circuit breaker for flight termination (required for HITL)
param set-default CBRK_FLIGHTTERM 121212

# HITL actuator output configuration (quadcopter)
param set-default HIL_ACT_FUNC1 101
param set-default HIL_ACT_FUNC2 102
param set-default HIL_ACT_FUNC3 103
param set-default HIL_ACT_FUNC4 104
