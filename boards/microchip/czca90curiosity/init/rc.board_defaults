#!/bin/sh
# PIC32CZ CA90 Curiosity Ultra board defaults

# Storage (SDMMC1 test config): SD card = params + flight logs (/fs/microsd)
#          SQI1 disabled — shares PC30/PG00-03 pins with SDMMC1 onboard socket.
#          Revert comment + dataman/param paths when SQI1 re-enabled on production PCB.

if [ -d "/fs/microsd" ]
then
	echo "INFO [init] SD card mounted at /fs/microsd"
	param select /fs/microsd/parameters
	param import
else
	echo "WARN [init] SD card NOT mounted - /fs/microsd missing"
fi

# ── Airframe ──────────────────────────────────
param set SYS_AUTOSTART 4001
param set SYS_USB_AUTO 2
param set USB_MAV_MODE 0
param set SYS_HAS_MAG 1
param set SYS_HAS_BARO 1
param set SYS_HAS_GPS 1

# ── MAVLink ───────────────────────────────────
# Curiosity board: USB HS (J102) is the GCS link — no SiK radio needed.
# SERCOM4 is repurposed for RC SBUS (see RC section below).
# Production PCB: change MAV_0_CONFIG=101 and RC_PORT_CONFIG=300 (SERCOM7).
param set MAV_0_CONFIG 0
param set MAV_0_RATE 57600
param set MAV_0_FORWARD 0
param set MAV_0_MODE 0
param set MAV_1_CONFIG 0
param set MAV_PROTO_VER 2
param set MAV_SYS_ID 1
param set MAV_TYPE 2

# ── Logging ───────────────────────────────────
param set SDLOG_MODE 0
param set SDLOG_PROFILE 1
param set SDLOG_BACKEND 1

# ── Sensors ───────────────────────────────────
param set SENS_EXT_I2C_PRB 0
param set SENS_IMU_MODE 1
param set SENS_MAG_MODE 1
param set SENS_MAG_RATE 15.0
param set SENS_BARO_RATE 20.0
param set SENS_BOARD_ROT 0

# ── GPS on SERCOM0 = /dev/ttyS1 (port type 201) ──
param set GPS_1_CONFIG 201
param set GPS_2_CONFIG 0

# ── EKF2 ──────────────────────────────────────
param set EKF2_EN 1
param set EKF2_HGT_REF 1
param set EKF2_BARO_CTRL 1
param set EKF2_GPS_CTRL 7
param set EKF2_MAG_TYPE 0
param set EKF2_MAG_CHECK 0
param set EKF2_DECL_TYPE 0
param set EKF2_MAG_DECL 0.5
param set EKF2_OF_CTRL 0
param set EKF2_IMU_CTRL 7

# ── RC Input on SERCOM4 = /dev/ttyS2 (port type 101, RXINV set in board.h) ──
# Curiosity: SERCOM7 (PD14/PD15) not exposed; use SERCOM4 (PC21/PC22, EXT2 pins 13/14).
# board.h BOARD_SERCOM4_MUXCONFIG has USART_CTRLA_RXINV; defconfig USART4 = 100000 8E2.
# Production PCB: change to RC_PORT_CONFIG=300 (SERCOM7) and MAV_0_CONFIG=101 (SERCOM4 telemetry).
param set RC_PORT_CONFIG 101
param set RC_INPUT_PROTO 2
param set RC_CHAN_CNT 18
param set RC_MAP_ROLL 1
param set RC_MAP_PITCH 2
param set RC_MAP_THROTTLE 3
param set RC_MAP_YAW 4
param set RC_MAP_FLTMODE 6
param set RC_MAP_ARM_SW 10
param set RC_MAP_KILL_SW 11
param set RC_MAP_RETURN_SW 7
param set RC_MAP_AUX1 9
param set RC_MAP_AUX2 5
param set RC_MAP_AUX3 8
param set RC_MAP_AUX4 12

# ── PWM motor output — TCC1 (ch 1-2) + TCC7 (ch 3-4), 400 Hz ──
param set PWM_MAIN_TIM0 400
param set PWM_MAIN_TIM1 400
param set PWM_MAIN_FUNC1 101
param set PWM_MAIN_FUNC2 102
param set PWM_MAIN_FUNC3 103
param set PWM_MAIN_FUNC4 104
param set PWM_MAIN_FUNC5 0
param set PWM_MAIN_FUNC6 0
param set PWM_MAIN_FUNC7 0
param set PWM_MAIN_FUNC8 0
param set PWM_MAIN_MIN1 1100
param set PWM_MAIN_MIN2 1100
param set PWM_MAIN_MIN3 1100
param set PWM_MAIN_MIN4 1100
param set PWM_MAIN_MAX1 1900
param set PWM_MAIN_MAX2 1900
param set PWM_MAIN_MAX3 1900
param set PWM_MAIN_MAX4 1900
param set PWM_MAIN_DIS1 1000
param set PWM_MAIN_DIS2 1000
param set PWM_MAIN_DIS3 1000
param set PWM_MAIN_DIS4 1000
param set PWM_MAIN_FAIL1 1000
param set PWM_MAIN_FAIL2 1000
param set PWM_MAIN_FAIL3 1000
param set PWM_MAIN_FAIL4 1000

# ── Circuit breakers ──────────────────────────
# param set (not set-default) — forced every boot regardless of SQI-saved values
param set CBRK_SUPPLY_CHK 894281
param set CBRK_USB_CHK 197848
param set CBRK_IO_SAFETY 22027
param set CBRK_FLIGHTTERM 121212
param set COM_ARM_SDCARD 0
param set COM_ARM_WO_GPS 1

# ── Commander ─────────────────────────────────
param set COM_DISARM_PRFLT 10.0
param set COM_SPOOLUP_TIME 1.0
param set COM_MOT_TEST_EN 1
param set COM_RC_LOSS_T 2.0
param set COM_DL_LOSS_T 10
param set COM_RC_OVERRIDE 1
param set MAN_ARM_GESTURE 0

# ── Flight Modes (All Stabilized for first flight) ──
param set COM_FLTMODE1 8
param set COM_FLTMODE2 8
param set COM_FLTMODE3 8
param set COM_FLTMODE4 8
param set COM_FLTMODE5 8
param set COM_FLTMODE6 8

# ── Failsafe ──────────────────────────────────
param set NAV_RCL_ACT 2
param set NAV_DLL_ACT 0

# ── PID — Conservative for first flight ───────
param set MC_ROLLRATE_P 0.15
param set MC_ROLLRATE_I 0.20
param set MC_ROLLRATE_D 0.003
param set MC_ROLLRATE_K 1.0
param set MC_ROLLRATE_MAX 220.0
param set MC_PITCHRATE_P 0.15
param set MC_PITCHRATE_I 0.20
param set MC_PITCHRATE_D 0.003
param set MC_PITCHRATE_K 1.0
param set MC_PITCHRATE_MAX 220.0
param set MC_YAWRATE_P 0.20
param set MC_YAWRATE_I 0.10
param set MC_YAWRATE_D 0.0
param set MC_YAWRATE_K 1.0
param set MC_YAWRATE_MAX 200.0
param set MC_ROLL_P 4.0
param set MC_PITCH_P 4.0
param set MC_YAW_P 2.8
param set MC_YAW_WEIGHT 0.4
param set MC_AT_EN 0

# ── Position Control ──────────────────────────
param set MPC_XY_VEL_P_ACC 1.8
param set MPC_XY_VEL_I_ACC 0.4
param set MPC_XY_VEL_D_ACC 0.2
param set MPC_THR_HOVER 0.5
param set MPC_THR_MIN 0.12
param set MPC_THR_MAX 1.0
param set MPC_MANTHR_MIN 0.08
param set MPC_LAND_SPEED 0.5
param set MPC_TKO_SPEED 1.5
param set MPC_MAN_TILT_MAX 35.0
param set MPC_Z_VEL_MAX_UP 3.0
param set MPC_Z_VEL_MAX_DN 1.5

# ── HITL actuator output configuration (quadcopter) ──
param set HIL_ACT_FUNC1 101
param set HIL_ACT_FUNC2 102
param set HIL_ACT_FUNC3 103
param set HIL_ACT_FUNC4 104

# ── Dataman — waypoint storage on SD card (SQI1 disabled) ───
dataman start -f /fs/microsd/dataman

# Flush param changes to SD card.
param save
