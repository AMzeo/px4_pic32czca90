#!/bin/sh
#
# PIC32CZ CA90 Curiosity Ultra board extras
#
# navigator requires sensors/commander to be running; disabled until
# sensor drivers are ported.

echo "INFO: rc.board_extras - no extras for CA90 bringup"

# rcS line 518 `if [ "$RC_INPUT_ARGS" != "" ]` fails in NuttX NSH when
# RC_INPUT_ARGS contains a space ("-d /dev/ttyS2") — test sees multiple tokens.
# Start rc_input here instead, after rc.serial has already run.
rc_input start -d /dev/ttyS2

# boot_complete must be set before QGC connects. cdcacm_autostart starts mavlink
# asynchronously after rcS exits, so the 20-second fallback is the only thing
# that sets it — QGC connects before 20 s and all PARAM_SET are dropped.
# rc.board_extras runs during rcS. Setting boot_complete here (before mavlink
# starts) means _boot_complete=true is already in place when cdcacm_autostart
# spawns mavlink. Same pattern as CA70 rc.board_extras.
mavlink boot_complete
